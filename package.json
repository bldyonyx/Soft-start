{
  "name": "soft-start",
  "displayName": "Soft Start",
  "description": "A cozy, customizable VS Code welcome dashboard",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "extensionKind": ["workspace"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Soft Start",
      "properties": {
        "softStart.projectsDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the parent folder for new projects on the active VS Code host. Leave empty to choose a parent folder when creating a project."
        }
      }
    },
    "commands": [
      {
        "command": "soft-start.openDashboard",
        "title": "Soft Start: Open Dashboard"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "build:webview": "npm --prefix webview run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
